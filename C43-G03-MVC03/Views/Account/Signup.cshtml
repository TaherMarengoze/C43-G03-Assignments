@model SignupViewModel

@{
    ViewData["Title"] = "Sign Up";
    Layout = "~/Views/Shared/_Auth.cshtml";
}

<section class="bg-light my-5 px-5 py-3 rounded rounded-3 mx-auto text-center" style="width: fit-content;">

    <h2>Sign Up</h2>

    <form asp-action="SignUp" method="post">

        <div asp-validation-summary="All"></div>

        <div class="form-group mb-1">
            <input asp-for="FirstName" placeholder="First Name" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group mb-1">
            <input asp-for="LastName" placeholder="Last Name" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="form-group mb-1">
            <input asp-for="Email" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-1">
            <input asp-for="Password" placeholder="User Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group mb-1">
            <input asp-for="ConfirmPassword" placeholder="Confirm Password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div>
            <input asp-for="IsAgree" />
            <span>I agree to the <a href="#">Terms & conditions</a>.</span>
        </div>

        <button type="submit" class="btn btn-success my-4">Sign Up</button>
    </form>

    <p>Have an account ? <a asp-action="SignIn">Sign In</a> instead</p>
</section>
