@model LoginViewModel

@{
    ViewData["Title"] = "Log In";
    Layout = "~/Views/Shared/_Auth.cshtml";
}

<section class="bg-light my-5 px-5 py-3 rounded rounded-3 mx-auto text-center" style="width: fit-content;">

    <h2>Sign Up</h2>

    <form asp-action="SignUp" method="post">

        <div asp-validation-summary="All"></div>

        <div class="form-group mb-1">
            <input asp-for="Email" type="email" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-1">
            <input asp-for="Password" type="password" placeholder="User Password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div>
            <input asp-for="RememberMe" />
            <span>Remember Me</span>
        </div>

        <button type="submit" class="btn btn-success my-4">Log In</button>
    </form>

    <p>Don't have an account ? <a asp-action="SignUp">Sign Up</a></p>

    <p>
        <a asp-action="ForgetPassword">Forget password</a>
    </p>

</section>
