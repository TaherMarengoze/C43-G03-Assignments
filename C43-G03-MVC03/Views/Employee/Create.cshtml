@model EmployeeDto

@{
    ViewData["Title"] = "";

    var departments = new SelectList(ViewBag.Departments,
        nameof(Department.Id), nameof(Department.Name));
}

<h2>Add New Employee</h2>
<br />
<br />

<form asp-action="Create" enctype="multipart/form-data">

    <div class="form-group">
        <label class="col-form-label" asp-for="Name"></label>
        <input type="text" class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>

    <div class="form-group">
        <label class="col-form-label" asp-for="Age"></label>
        <input type="number" class="form-control" asp-for="Age" />
        <span class="text-danger" asp-validation-for="Age"></span>
    </div>

    <div class="form-group">
        <label class="col-form-label" asp-for="Address"></label>
        <input type="text" class="form-control" asp-for="Address" />
        <span class="text-danger" asp-validation-for="Address"></span>
    </div>

    <div class="form-group">
        <label class="col-form-label" asp-for="Salary"></label>
        <input type="number" class="form-control" asp-for="Salary" />
        <span class="text-danger" asp-validation-for="Salary"></span>
    </div>

    <div class="form-group">
        <label class="col-form-label" asp-for="Email"></label>
        <input type="text" class="form-control" asp-for="Email" />
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="form-group">
        <label class="col-form-label" asp-for="Phone"></label>
        <input type="text" class="form-control" asp-for="Phone" />
        <span class="text-danger" asp-validation-for="Phone"></span>
    </div>

    <div class="form-group">
        <label class="col-form-label" asp-for="HiringDate"></label>
        <input type="date" class="form-control" asp-for="HiringDate" />
        <span class="text-danger" asp-validation-for="HiringDate"></span>
    </div>

    <div>
        <label class="col-form-label" asp-for="Department"></label>
        <select class="form-control" asp-items="@departments" asp-for="DepartmentId">
            <option value="@null" selected disabled>-- Select Department --</option>
        </select>
    </div>

    <div>
        <label class="col-form-label" asp-for="Image">Image</label>
        <input type="file" class="form-control-file" asp-for="Image" />
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        <button type="submit" class="btn btn-success">Add Employee</button>
    </div>
</form>