@model IEnumerable<EmployeeDto>

@{
    ViewData["Title"] = "Index";
    const string imagesRoot = @"/Files/Images/";
}

<div class="text-end">
    <a asp-action="Create" class="btn btn-primary">Add New Employee</a>
</div>

<div class="text-center">
    <form asp-action="Index" class="d-flex w-75">
        <input name="searchKey" placeholder="Enter name of employees to search for" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
    </form>
</div>

@if (Model.Count() > 0)
{
    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Image</th>
                <th>@Html.DisplayNameFor(m => m.Name)</th>
                <th>@Html.DisplayNameFor(m => m.Age)</th>
                <th>@Html.DisplayNameFor(m => m.Address)</th>
                <th>@Html.DisplayNameFor(m => m.Salary)</th>
                <th>@Html.DisplayNameFor(m => m.Email)</th>
                <th>@Html.DisplayNameFor(m => m.Phone)</th>
                <th>@Html.DisplayNameFor(m => m.HiringDate)</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>
                        @{
                            var imgUrl = imagesRoot + employee.ImageUrl;
                        }
                        <img src="@imgUrl" alt="Employee Profile" width="48" />
                    </td>

                    <td>@employee.Name</td>
                    <td>@employee.Age</td>
                    <td>@employee.Address</td>
                    <td>@employee.Salary</td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.HiringDate</td>
                    
                    <td>
                        <partial name="_ActionButtonsPartialView" model="@employee.Id.ToString()" />
                    </td>

                </tr>
            }
        </tbody>

    </table>
}
else
{
    <div class="alert alert-warning text-center w-100">No Data</div>
}
