@model IEnumerable<DepartmentDto>

@{
    ViewData["Title"] = "Index";
}

<a asp-action="Create" class="btn btn-primary">Add New Department</a>

<table class="table">

    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Code)</th>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.CreatedAt)</th>
            <th class="text-center">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.Code</td>
                <td>@dept.Name</td>
                <td>@dept.CreatedAt</td>
                <td>
                    <partial name="_ActionButtonsPartialView" model="@dept.Id.ToString()" />
                </td>
                
            </tr>
        }
    </tbody>

</table>
